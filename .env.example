# ─────────────────────────────────────────────────────────────────────────────
# Tirvo · variáveis de ambiente
# Copie para .env e preencha. O deploy/oracle-setup.sh gera este arquivo sozinho,
# com senhas aleatórias. Nunca envie o .env para o GitHub.
#
# Quase tudo da loja (WhatsApp, endereço, frete, Stripe, Pix, mapas, notificações)
# é configurado no painel em /admin → Configurações, não aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Domínio do site, sem https:// (ex.: loja.tirvo.com.br ou tirvo.duckdns.org).
# Use "localhost" para testar no computador: o Caddy cria um HTTPS local.
DOMAIN=localhost

# Endereço público completo da loja, usado em links do WhatsApp, e-mails e Stripe.
APP_URL=https://localhost

# ───────── Banco de dados (MySQL 8)
# Use só letras e números nas senhas (elas entram na URL de conexão).
MYSQL_DATABASE=tirvo
MYSQL_USER=tirvo
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# URL de conexão do Prisma. No Docker Compose ela é montada a partir das variáveis
# MYSQL_* acima (servidor "mysql"). Para rodar fora do Docker (npm run dev), troque
# "mysql" por 127.0.0.1 e use o usuário e a senha do seu MySQL local.
DATABASE_URL=mysql://tirvo:troque-esta-senha@mysql:3306/tirvo

# ───────── Segurança
# Chave que assina a sessão do painel e criptografa as chaves da Stripe/mapas no banco.
# Gere com: openssl rand -hex 32
# Atenção: se trocar depois, todos saem do painel e as chaves salvas em Configurações
# (Stripe, mapas) precisam ser digitadas de novo.
AUTH_SECRET=

# ───────── Primeiro acesso ao painel
# O administrador (proprietário) é criado com estes dados no primeiro login ou no seed.
# Depois de entrar, troque a senha em /admin → Usuários.
ADMIN_EMAIL=admin@tirvo.com.br
ADMIN_PASSWORD=

# ───────── Arquivos
# Pasta das imagens enviadas pelo painel. No Docker fica em ./data/uploads da VM.
UPLOAD_DIR=./data/uploads

# ───────── Opcional
# Servidor OSRM próprio para calcular a rota do motoboy quando o provedor de mapas
# é o OpenStreetMap (o público tem limite de uso). Ex.: https://osrm.seudominio.com.br
OSRM_URL=

# Portas publicadas pelo Caddy (mude só se 80/443 já estiverem em uso).
# HTTP_PORT=80
# HTTPS_PORT=443
