    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "fflate": "0.8.3",
    "geist": "1.8.1",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
