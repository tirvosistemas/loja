{
  "name": "tirvo-loja",
  "version": "1.0.0",
  "private": true,
  "description": "Tirvo — loja virtual de eletrônicos (Curitiba e região metropolitana)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
