# MySQL da Tirvo: ajustes para uma VM pequena (Oracle Cloud Always Free).
# Montado em /etc/mysql/conf.d/ pelo docker-compose.yml.

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
skip-name-resolve

# Memória: a loja tem poucos dados; 256 MB de buffer cobrem catálogo e pedidos com folga.
innodb_buffer_pool_size = 256M
innodb_log_buffer_size = 16M
innodb_redo_log_capacity = 268435456
max_connections = 60
table_open_cache = 400
tmp_table_size = 32M
max_heap_table_size = 32M

# O performance_schema consome ~200 MB e não é usado aqui.
performance_schema = OFF

# Binlog desligado: não há réplica e os backups são feitos com mysqldump.
disable_log_bin

# Horário em UTC (o app converte para o fuso de Curitiba).
default-time-zone = '+00:00'

[client]
default-character-set = utf8mb4
