# Ambiente de teste da imagem de produção, isolado do desenvolvimento. Não use em produção.
#   docker compose -p tirvotest --env-file docker/.env.test -f docker-compose.yml -f docker/compose.local.yml up -d --build mysql app
#   docker compose -p tirvotest --env-file docker/.env.test -f docker-compose.yml -f docker/compose.local.yml run --rm tools npm run db:seed
#   docker compose -p tirvotest --env-file docker/.env.test -f docker-compose.yml -f docker/compose.local.yml --profile tools down -v
ENV_FILE=docker/.env.test
DOMAIN=localhost
APP_URL=http://localhost:3100
APP_PORT=3100
HTTP_PORT=8180
HTTPS_PORT=8543
MYSQL_DATABASE=tirvo
MYSQL_USER=tirvo
MYSQL_PASSWORD=testepass123
MYSQL_ROOT_PASSWORD=testeroot123
AUTH_SECRET=teste-0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_EMAIL=admin@tirvo.com.br
ADMIN_PASSWORD=tirvo123
UPLOADS_PATH=/tmp/tirvotest-uploads
